# Web (apps/web). Only VITE_* values are exposed to the browser. Never put secrets here.
# Dev: the path below is same-origin and Vite proxies /api to the local API. Production: set the full API origin
# (e.g. https://your-api.example.com/api/v1) and see docs/deployment.md for the cross-origin cookie requirements.
VITE_API_BASE_URL=/api/v1
# Optional. Set to "demo" to force sample data even when an API URL is set.
VITE_DATA_SOURCE=api
# Canonical site URL used for SEO tags, e.g. https://www.example.com (no trailing slash).
VITE_SITE_URL=http://localhost:5173
