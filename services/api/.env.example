# API (services/api). Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
# Comma-separated web origins allowed for CORS (no trailing slash, no path).
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/premium-seat-covers
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-64-random-characters-generated-locally-xxxxxxxxxxxxxxxxxx
# Digits with country code, no plus sign. Optional until WhatsApp links are configured.
WHATSAPP_NUMBER=919999999999
# Cloudinary is needed only for image uploads (not yet enabled).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used only by `npm run seed`. Password must be at least 12 characters.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-password-now
